# ── Kafka ──────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# For Confluent Cloud: pkc-xxxxx.us-east-1.aws.confluent.cloud:9092
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# ── Databricks ─────────────────────────────────────────────────────────────────
DATABRICKS_HOST=https://adb-<workspace-id>.azuredatabricks.net
DATABRICKS_TOKEN=dapi...
DATABRICKS_CLUSTER_ID=0101-123456-abcde123
DATABRICKS_STREAMING_JOB_ID=12345
DATABRICKS_BATCH_JOB_ID=67890

# ── NHL API ────────────────────────────────────────────────────────────────────
# Public API — no key required, but reserve a slot for future authenticated endpoints
NHL_API_KEY=

# ── Alerting (optional) ────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
ALERT_EMAIL=ops@example.com
